{
  "name": "nogrammerly-word",
  "version": "0.1.0",
  "private": true,
  "description": "Word add-in for Nogrammerly. Checks text with the Nogrammerly app on the same PC.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "certs": "npx --yes office-addin-dev-certs install",
    "start": "node serve.js",
    "sideload": "npx --yes office-addin-debugging start manifest.xml desktop --no-debug --dev-server-port 3000",
    "unload": "npx --yes office-addin-debugging stop manifest.xml",
    "hosted": "node hosted.js",
    "sideload:hosted": "npx --yes office-addin-debugging start manifest.hosted.xml desktop --no-debug"
  }
}
